{
  "productName": "DBX Custom",
  "identifier": "com.hunshui0.dbx.custom",
  "version": "0.6.51-custom.1",
  "mainBinaryName": "dbx-custom",
  "app": {
    "windows": [{
      "label": "main", "title": "DBX Custom", "width": 1280, "height": 800,
      "minWidth": 900, "minHeight": 600, "resizable": true,
      "fullscreen": false, "visible": false, "titleBarStyle": "Overlay",
      "hiddenTitle": true, "acceptFirstMouse": true
    }]
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "fileAssociations": [],
    "resources": {"custom-resources/": "custom/"},
    "windows": {
      "webviewInstallMode": {"silent": true, "type": "offlineInstaller"}
    }
  },
  "plugins": {
    "deep-link": {"desktop": {"schemes": ["dbx-custom"]}},
    "updater": {"endpoints": []}
  }
}
